FROM docker.io/library/python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y \
    git \
    iptables \
    ripgrep \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /usr/sbin/nologin sandbox

COPY requirements.txt /opt/tapestry/
RUN pip install --no-cache-dir -r /opt/tapestry/requirements.txt

# The container is disposable, so there is no virtualenv. The system Python
# stays root-owned, so pip run by the sandbox user falls back to a user install
# under its home directory. PIP_USER is deliberately unset: it would also turn
# pip list/freeze into --user listings that hide build-time packages.
ENV PATH=$PATH:/home/sandbox/.local/bin

COPY server.py entrypoint.py /opt/tapestry/

RUN mkdir /workspace \
    && chown -R sandbox:sandbox /workspace
WORKDIR /workspace

EXPOSE 8080

# The entrypoint starts as root solely to install the deny-by-default OUTPUT
# firewall, then irreversibly drops to the sandbox user before the HTTP server
# starts or any tool code can execute.
USER root
STOPSIGNAL SIGTERM
ENTRYPOINT ["python", "/opt/tapestry/entrypoint.py"]
